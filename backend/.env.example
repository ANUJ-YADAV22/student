# Copy to .env for local development. On Render, set these under Dashboard > Environment.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/studentDB?retryWrites=true&w=majority
PORT=5000
# Comma-separated allowed frontend origins (no trailing slash)
FRONTEND_URL=https://student-management-system.netlify.app
